NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/cognition_iq?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Generate once and keep forever for this college: node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
COLLEGE_ID=replace-with-24-hex-characters
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-me-with-a-different-32-char-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# 32 random bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every enrolled 2FA secret unusable. Back it up in the secret manager.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hex-characters
# Password hashing cost (T-02). Tune so one hash takes roughly 100-250 ms on the real host.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# 'inline' = the API process also runs the import worker (fine for development).
# Production: set 'off' and run `npm run start:worker -w server` as a separate process.
IMPORT_WORKER=inline
# Import rows (names, login IDs) are auto-deleted this many days after completion. Set per D-06.
IMPORT_RETENTION_DAYS=30
COOKIE_SECURE=false
LOG_LEVEL=info


