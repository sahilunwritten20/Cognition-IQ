NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/cognition_iq?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Generate once and keep forever for this college: node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
COLLEGE_ID=replace-with-24-hex-characters
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-me-with-a-different-32-char-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# 32 random bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every enrolled 2FA secret unusable. Back it up in the secret manager.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hex-characters
# Password hashing cost (T-02). Tune so one hash takes roughly 100-250 ms on the real host.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
COOKIE_SECURE=false
LOG_LEVEL=info

# Used ONLY by `npm run seed:admin -w server`. Remove these lines after the first admin exists.
# SEED_ADMIN_LOGIN_ID=admin@college.edu
# SEED_ADMIN_NAME=Super Admin
# SEED_ADMIN_PASSWORD=choose-a-long-temporary-password

# Used ONLY by the break-glass script `npm run recover:admin -w server -- --yes`
# (see docs/operations/RUNBOOK-admin-recovery.md). Remove after use.
# RECOVER_LOGIN_ID=admin@college.edu
# RECOVER_NEW_PASSWORD=optional-new-temporary-password-12plus-chars
